# Anthropic API key — required for claim classification and verdict rendering
ANTHROPIC_API_KEY=

# Model names
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Paths (defaults are relative to repo root; override only if needed)
DATA_DIR=./data
STATUTES_DIR=./data/statutes
JUDGMENTS_DIR=./data/judgments/golden_set
INDICES_DIR=./data/indices

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
