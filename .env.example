# Gemini API key — required for claim classification and verdict rendering.
# (The spec's primary LLM choice was Claude/Anthropic; this build uses
# Gemini's structured-output API instead — see backend/verification/llm_client.py.)
GEMINI_API_KEY=

# Model name
GEMINI_MODEL=gemini-3.6-flash

# Paths (defaults are relative to repo root; override only if needed)
DATA_DIR=./data
STATUTES_DIR=./data/statutes
JUDGMENTS_DIR=./data/judgments/golden_set
INDICES_DIR=./data/indices

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
